<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Content Brief — {{ brief.keyword }}</title>
  <style>
    :root {
      --blue: #2563eb; --blue-light: #dbeafe;
      --green: #16a34a; --green-light: #dcfce7;
      --gray-50: #f9fafb; --gray-100: #f3f4f6;
      --gray-700: #374151; --gray-900: #111827;
      --font: 'Inter', system-ui, -apple-system, sans-serif;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: var(--font); color: var(--gray-900); background: #fff; line-height: 1.6; }
    .container { max-width: 960px; margin: 0 auto; padding: 2rem 1.5rem; }
    header { background: var(--blue); color: #fff; padding: 2rem 1.5rem; }
    header h1 { font-size: 1.6rem; font-weight: 700; }
    header .meta { margin-top: .5rem; font-size: .9rem; opacity: .85; }
    .section { margin-top: 2rem; }
    .section h2 { font-size: 1.1rem; font-weight: 700; color: var(--blue);
                  border-bottom: 2px solid var(--blue-light); padding-bottom: .4rem; margin-bottom: 1rem; }
    .overview-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .kv { background: var(--gray-50); border-radius: 8px; padding: .75rem 1rem; }
    .kv .label { font-size: .75rem; font-weight: 600; text-transform: uppercase;
                 letter-spacing: .05em; color: #6b7280; }
    .kv .value { margin-top: .2rem; font-size: .95rem; font-weight: 500; }
    .heading-list { list-style: none; }
    .heading-list li { padding: .3rem 0; border-bottom: 1px solid var(--gray-100); }
    .heading-list li .level { display: inline-block; width: 2rem; font-size: .75rem;
                               font-weight: 700; color: #6b7280; }
    .heading-list li .note { font-size: .8rem; color: #6b7280; font-style: italic; margin-left: .5rem; }
    .tag { display: inline-block; background: var(--blue-light); color: var(--blue);
            padding: .2rem .6rem; border-radius: 999px; font-size: .78rem;
            font-weight: 600; margin: .2rem .2rem 0 0; }
    .gap-card { background: var(--gray-50); border-left: 4px solid var(--green);
                 border-radius: 0 8px 8px 0; padding: .75rem 1rem; margin-bottom: .75rem; }
    .gap-card .topic { font-weight: 700; }
    .gap-card .coverage { font-size: .8rem; color: #6b7280; margin-top: .15rem; }
    .gap-card .opp { font-size: .9rem; margin-top: .3rem; }
    .paa-list { list-style: disc; padding-left: 1.5rem; }
    .paa-list li { margin-bottom: .4rem; }
    .hook-card { background: var(--gray-50); border-radius: 8px; padding: .75rem 1rem;
                  margin-bottom: .6rem; }
    .hook-card .hook-num { font-size: .75rem; font-weight: 700; color: var(--blue);
                            text-transform: uppercase; }
    table.competitor-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    table.competitor-table th { background: var(--blue); color: #fff; padding: .5rem .75rem;
                                  text-align: left; font-size: .8rem; }
    table.competitor-table td { padding: .5rem .75rem; border-bottom: 1px solid var(--gray-100); }
    table.competitor-table tr:nth-child(even) td { background: var(--gray-50); }
    footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--gray-100);
              font-size: .78rem; color: #9ca3af; text-align: center; }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <h1>SEO Content Brief</h1>
      <div class="meta">
        Keyword: <strong>{{ brief.keyword }}</strong> &nbsp;·&nbsp;
        Generated: {{ brief.generated_at[:10] }} &nbsp;·&nbsp;
        llm-content-brief-engine
      </div>
    </div>
  </header>

  <div class="container">

    <div class="section">
      <h2>Overview</h2>
      <div class="overview-grid">
        <div class="kv"><div class="label">Search Intent</div><div class="value">{{ brief.search_intent }}</div></div>
        <div class="kv"><div class="label">Word Count Target</div><div class="value">{{ brief.word_count_min | int | string | replace(",","") }} – {{ brief.word_count_max | int | string | replace(",","") }} words</div></div>
        <div class="kv"><div class="label">Tone</div><div class="value">{{ brief.tone }}</div></div>
        <div class="kv"><div class="label">Avg Competitor Length</div><div class="value">{{ brief.avg_competitor_word_count }} words</div></div>
        <div class="kv" style="grid-column:1/-1"><div class="label">Suggested Meta Title</div><div class="value">{{ brief.meta_title_suggestion }}</div></div>
        <div class="kv" style="grid-column:1/-1"><div class="label">Suggested Meta Description</div><div class="value">{{ brief.meta_description_suggestion }}</div></div>
      </div>
    </div>

    <div class="section">
      <h2>Heading Structure</h2>
      <ul class="heading-list">
        {% for h in brief.heading_structure %}
        <li>
          <span class="level">H{{ h.level }}</span>
          {{ h.text }}
          {% if h.notes %}<span class="note">{{ h.notes }}</span>{% endif %}
        </li>
        {% endfor %}
      </ul>
    </div>

    <div class="section">
      <h2>Entities &amp; Topics to Cover</h2>
      {% for e in brief.entities_to_cover %}
      <span class="tag">{{ e }}</span>
      {% endfor %}
    </div>

    <div class="section">
      <h2>Competitor Gap Opportunities</h2>
      {% for gap in brief.competitor_gaps %}
      <div class="gap-card">
        <div class="topic">{{ gap.topic }}</div>
        <div class="coverage">Covered by {{ gap.coverage_pct }}% of top results</div>
        <div class="opp">{{ gap.opportunity }}</div>
      </div>
      {% endfor %}
    </div>

    <div class="section">
      <h2>People Also Ask — Address These</h2>
      <ul class="paa-list">
        {% for q in brief.paa_to_answer %}
        <li>{{ q }}</li>
        {% endfor %}
      </ul>
    </div>

    <div class="section">
      <h2>Intro Hook Ideas</h2>
      {% for hook in brief.intro_hook_suggestions %}
      <div class="hook-card">
        <div class="hook-num">Option {{ loop.index }}</div>
        <div>{{ hook }}</div>
      </div>
      {% endfor %}
    </div>

    {% if brief.internal_link_suggestions %}
    <div class="section">
      <h2>Internal Linking Suggestions</h2>
      <ul class="paa-list">
        {% for link in brief.internal_link_suggestions %}
        <li><a href="{{ link }}" rel="noopener">{{ link }}</a></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    <div class="section">
      <h2>Competitor Analysis (Top {{ brief.competitors | length }})</h2>
      <table class="competitor-table">
        <thead>
          <tr><th>#</th><th>Page</th><th>Words</th><th>Key H2s</th></tr>
        </thead>
        <tbody>
          {% for c in brief.competitors %}
          <tr>
            <td>{{ c.rank }}</td>
            <td><a href="{{ c.url }}" rel="noopener noreferrer" target="_blank">{{ c.meta_title or c.url[:60] }}</a></td>
            <td>{{ c.word_count }}</td>
            <td>{{ c.h2_headings | join(" · ") or "—" }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <footer>
      Generated by <a href="https://github.com/mehranmoghadasi/llm-content-brief-engine">llm-content-brief-engine</a>
      · MIT License · <a href="https://github.com/mehranmoghadasi">mehranmoghadasi</a>
    </footer>

  </div>
</body>
</html>
