# Required: OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o

# Optional: Anthropic support (set API key + model, then pass --model)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: output directory override (default: ./output)
# BRIEF_OUTPUT_DIR=./briefs

# Optional: max crawl results (default: 10)
# BRIEF_MAX_RESULTS=10

# Optional: crawl delay between page fetches in seconds (default: 0.8)
# BRIEF_CRAWL_DELAY=0.8
