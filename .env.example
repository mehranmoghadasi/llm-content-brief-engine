# Required: OpenAI API key (any non-empty string when using a local OpenAI-compatible server)
OPENAI_API_KEY=sk-...

# Optional: model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o

# Optional: point the OpenAI SDK at any OpenAI-compatible server (Ollama, OpenRouter, LM Studio ...)
# OPENAI_BASE_URL=http://localhost:11434/v1

# Optional: max crawl results (default: 10)
# BRIEF_MAX_RESULTS=10

# Optional: crawl delay between page fetches in seconds (default: 0.8)
# BRIEF_CRAWL_DELAY=0.8
